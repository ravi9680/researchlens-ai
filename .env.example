# --- Core ---
DATABASE_URL=
JWT_SECRET=dev-secret-change-me
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# --- Demo / providers ---
DEMO_MODE=true
AI_API_KEY=
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai  # needs AI_API_KEY; then run `npm run reembed`

# --- Ingestion (real sources, optional) ---
# Ingestion currently uses OpenAlex only. The mailto address is sent as the
# polite-pool identifier and the User-Agent contact.
OPENALEX_EMAIL=
CROSSREF_EMAIL=you@example.com

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_MB=25

# --- Security ---
# Token lifetimes. Access tokens are short-lived; refresh tokens are
# single-use and stored only as a SHA-256 hash.
TOKEN_TTL=2h
REFRESH_TOKEN_TTL=30d
# Password hashing cost (12 in production).
BCRYPT_ROUNDS=10
# Failed sign-ins per account+IP before the window locks the route.
AUTH_WINDOW_MS=900000
AUTH_MAX_ATTEMPTS=10
MIN_PASSWORD_LENGTH=8
# Ceiling on stored analyses per account.
MAX_UPLOADS_PER_USER=50
# Hourly cap on how many guest identities may be minted in total.
GUEST_PER_IP_LIMIT=20
# Trust the reverse proxy (Render/nginx) so rate limiting sees the real IP.
TRUST_PROXY=true
